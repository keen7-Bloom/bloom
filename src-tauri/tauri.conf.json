{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bloom",
  "version": "0.3.0",
  "identifier": "com.bloomwallpaper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwQkU0QzRCNUQxMDA1MkUKUldRdUJSQmRTMHkrUUJtdWFWSGx1dERBTXRRN0Z5bVc2UTZmR3FaRkRPWEhjSFdWaldFQlFKaWIK",
      "endpoints": [
        "https://github.com/keen7-Bloom/bloom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}